# Node / frontend
node_modules/
dist/
build/
.vite/
*.local

# Python / AppSail
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# Catalyst
.catalyst/
catalyst-deploy/
*.zip
# scripts/bundle_data_for_deploy.py copies data/{synthetic,reference,gazetteer}
# in here right before `catalyst deploy`, so app/'s AppSail bundle is
# self-contained. Deploy-time artifact, not source — never commit it.
app/data/
# ...and the built React SPA, copied into app/webclient/ so the single AppSail
# instance serves it at /ui/. Deploy-time artifact, regenerable from the build.
app/webclient/
# ...and the vendored ARM64 (aarch64) Python deps. AppSail's managed runtime does
# NOT pip-install requirements.txt server-side, so deps are pre-installed into
# app/lib as manylinux2014_aarch64 wheels and shipped in the bundle (PYTHONPATH=lib).
# Regenerable via scripts/bundle_data_for_deploy.py — never commit (~200MB).
app/lib/

# Secrets & env
.env
.env.*
*.pem
*.key
credentials.json

# Generated data (keep the generator + ground_truth.json, not the bulk output)
data/synthetic/*.csv
data/synthetic/*.parquet
# loader --dry-run / --emit-csv output (regenerable)
data/**/_canonical/
# scripts/make_dev_subset.py output — the Dev-tier Data Store import set (regenerable)
data/**/_dev_subset/
# scripts/bake_warmstart.py output — deploy-time precomputed JSON (regenerable)
data/warmstart/
*.sqlite
# NOTE: reference CSVs (ipc_bns_map, census_2011, geo_boundaries, gazetteer) and
# data/synthetic/ground_truth.json ARE committed; only large raw GeoJSON is ignored.
data/reference/*.geojson
# Generated FIR renders (regenerable from generate_firs.py); keep the generator +
# the golden key fir_key.json, not the bulk .txt/.png output.
data/fir_samples/*.txt
data/fir_samples/*.png
# Local PoC store + Phase-5 generated outputs (default GARUDA_HOME; regenerable).
# External GARUDA_HOME (e.g. ~/Desktop/garuda) lives outside the repo entirely.
data/local/
*.db

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
data/synthetic/*.npz
